# Banco PostgreSQL do servidor local J&T (substitua SOMENTE a senha abaixo).
# A conexao exige acesso de rede ao servidor/VM PostgreSQL na porta 5432.
# Se o projeto roda fora do computador que hospeda a VM, o IP host-only 192.168.56.10 pode nao ser acessivel.
DATABASE_URL=postgresql://jt_app:SUA_SENHA@192.168.56.10:5432/jt_indicadores

# Credenciais do painel (recomendadas antes de publicar na web)
# DASH_USER=seu_usuario
# DASH_PASS=senha_forte

# Meta provisoria; confirmar meta oficial
META_1BD=0.80

# NOTA: JT_API_URL e JT_API_KEY NAO sao usados pelo banco PostgreSQL neste projeto.
# A integracao via HTTP exige uma rota de importacao na API JT.
