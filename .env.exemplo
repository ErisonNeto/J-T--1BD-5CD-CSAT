# USAR A NOVA CONTA SUPABASE. Salve uma cópia como .env no PC da J&T.
# Nunca publique .env nem cole a chave secreta em um chat.
JT_STORAGE_MODE=supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_CACHE_SECONDS=120
META_1BD=0.80
# Em produção configure credenciais Basic Auth no Render:
DASH_USER=
DASH_PASS=
# JWT legado (evite em projetos novos): SUPABASE_SERVICE_ROLE_KEY=
